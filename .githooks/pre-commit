#!/bin/sh
# 공개 리포 안전장치: 판단이 아니라 패턴으로 막는다.
# 설치: git config core.hooksPath .githooks
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

hit() { echo "✋ 커밋 차단 — $1"; echo "$2"; fail=1; }

t=$(git diff --cached -U0 -- $staged | grep -E "^\+" | grep -oE "ntn_[A-Za-z0-9]{10,}|secret_[A-Za-z0-9]{10,}|ghp_[A-Za-z0-9]{10,}|github_pat_[A-Za-z0-9_]{10,}")
[ -n "$t" ] && hit "토큰으로 보이는 문자열" "$t"

h=$(git diff --cached -U0 -- $staged | grep -E "^\+" | grep -oE "\b[0-9a-f]{32}\b")
[ -n "$h" ] && hit "노션 페이지/DB id로 보이는 32자 hex" "$h"

p=$(git diff --cached -U0 -- $staged | grep -E "^\+" | grep -oE "/home/[a-z0-9_-]+/|/mnt/[A-Za-z]/[A-Za-z0-9_-]+/")
[ -n "$p" ] && hit "개인 절대경로" "$(echo "$p" | sort -u)"

# 조직·프로젝트 식별자. 이 훅 파일 자신은 패턴 정의부이므로 검사 대상에서 뺀다.
# 대소문자를 구분한다 — 소문자 irs 는 first·dirs 등에 걸려 쓸 수 없다.
# 한계: 스키마·컬럼·변수명은 종류가 많아 패턴으로 다 잡히지 않는다. 승격 시 사람이 함께 본다.
org=$(echo "$staged" | grep -v '^\.githooks/pre-commit$')
if [ -n "$org" ]; then
  o=$(git diff --cached -U0 -- $org | grep -E "^\+" | grep -oE "srv-a|srv-a|proj-x|proj-x|repo-y|sch-a|sch-b|sch-c|sch-d|sch-e|srv-a|ubuntu-b|mac-c|사번|P[0-9]{9}|10\.(6|7)[0-9]\.[0-9]|165\.24[34]\.")
  [ -n "$o" ] && hit "조직·프로젝트 식별자" "$(echo "$o" | sort -u)"
fi

[ $fail -eq 1 ] && echo "" && echo "의도한 것이면: git commit --no-verify"
exit $fail
